};

function setDiagram(key, target="main"){
  const d    = DIAGRAMS[key];
  const img  = target==="question" ? els.qDiagramImg   : els.mainDiagramImg;
  const ph   = target==="question" ? els.qDiagramPh    : els.mainDiagramPh;
  const cred = target==="question" ? els.qDiagramCredit: els.mainDiagramCredit;

  if(!d){
    ph.style.display  = "block";
    ph.textContent    = "No diagram available for this selection.";
    img.style.display = "none";
    cred.textContent  = "";
    return;
  }

  ph.style.display  = "block";
  ph.textContent    = "Loading…";
  img.style.display = "none";

  const tryLoad = (src, isFallback) => {
    img.onload = () => {
      img.style.display = "block";
      ph.style.display  = "none";
      cred.innerHTML    = `${esc(d.credit)} · ${esc(d.license)}`
        + (d.page ? ` · <a href="${esc(d.page)}" target="_blank" rel="noopener noreferrer">source</a>` : "");
    };
    img.onerror = () => {
      if(!isFallback && d.fallbackUrl){
        tryLoad(d.fallbackUrl, true);
      } else {
        img.style.display = "none";
        ph.style.display  = "block";
        ph.innerHTML = `Could not load diagram. `
          + `<a href="${esc(d.page||"https://commons.wikimedia.org")}" target="_blank" rel="noopener noreferrer">Open on Wikimedia Commons ↗</a>`;
        cred.textContent = "";
      }
    };
    img.src = src;
  };

  tryLoad(d.url, false);
}

// Legacy alias so old calls still work
function loadDiagram(searchTerm, target="main"){
  // Map old search strings to diagram keys
  const map = {
    "Noctuidae wing pattern terminology": "wing-pattern",
    "Lepidoptera wing venation":           "venation",
    "Catocala forewing pattern":           "catocala"
  };
  setDiagram(map[searchTerm] || "wing-pattern", target);
}

/* ═══════════════════════════════════════════════════
   STATUS HELPER
═══════════════════════════════════════════════════ */
function setStatus(msg, cls=""){
  els.status.textContent  = msg;
  els.status.className    = "status-line" + (cls ? " "+cls : "");
}

/* ═══════════════════════════════════════════════════
   INITIALISE
═══════════════════════════════════════════════════ */
function initializeCandidates(){
  candidates = curatedProfiles.map(p => ({
    ...p,
    source:      "curated",
    localCount:  0,
    localPrior:  0.35,
    gbifKey:     null,
    image:       null,
    imageCredit: null,
    imageSource: null,
    commonsPage: null
  }));
  renderAll();
  scheduleImageEnrichment();
  setDiagram("question-default", "question");
}

/* ═══════════════════════════════════════════════════
   EVENT WIRING
═══════════════════════════════════════════════════ */
// Tab switching
document.querySelectorAll(".tab").forEach(btn =>
  btn.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    ["key-panel","diagram-panel","analytics-panel","sources-panel"].forEach(id =>
      $(id).classList.toggle("hidden", id !== btn.dataset.panel));
  })
);

// Navigation
els.searchBtn.addEventListener("click", loadLocalCandidates);
els.locationInput.addEventListener("keydown", e => { if(e.key==="Enter") loadLocalCandidates(); });
els.nextBtn.addEventListener("click", nextQuestion);
els.backBtn.addEventListener("click", backQuestion);
els.skipBtn.addEventListener("click", () => {
  if(currentQid) answers[currentQid] = "unknown";
  nextQuestion();
});
els.resetBtn.addEventListener("click", () => {
  if(confirm("Reset all answers?")) resetKey();
});

// Diagram panel buttons
$("load-wing-pattern").addEventListener("click", () => setDiagram("wing-pattern", "main"));
$("load-venation").addEventListener("click",     () => setDiagram("venation", "main"));
$("load-catocala").addEventListener("click",     () => setDiagram("catocala", "main"));
$("load-genitalia-note").addEventListener("click", () => {
  els.mainDiagramImg.style.display  = "none";
  els.mainDiagramPh.style.display   = "block";
  els.mainDiagramPh.innerHTML = `<strong style="color:var(--warn-ink)">⚠ Genitalia note</strong><br><br>
    Many moth genera (especially Acronicta, Catocala, and micromoths) require genitalia dissection for
    species-level determination. Visual keys cannot replace this for cryptic species pairs.
    Refer to specialist keys such as Covell (1984), Lafontaine & Fibiger (2006), or regional treatments.`;
  els.mainDiagramCredit.textContent = "";
});

// Sort / filter
if(els.filterFamily) els.filterFamily.addEventListener("change", renderResults);
if(els.sortBy)       els.sortBy.addEventListener("change", renderResults);

// Boot
initializeCandidates();
</script>
