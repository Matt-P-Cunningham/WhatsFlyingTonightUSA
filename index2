/* ═══════════════════════════════════════════════════
   UTILITY
═══════════════════════════════════════════════════ */
function esc(s){
  return String(s ?? "").replace(/[&<>"']/g,
    c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function getMonths(){
  const now = new Date(), months = new Set();
  for(let d = -WINDOW_DAYS; d <= WINDOW_DAYS; d++){
    const dt = new Date(now);
    dt.setDate(now.getDate() + d);
    months.add(dt.getMonth() + 1);
  }
  return [...months].join(",");
}

function charById(id){ return characters.find(c => c.id === id); }

/* ═══════════════════════════════════════════════════
   SCORING ENGINE
═══════════════════════════════════════════════════ */
function compatible(answer, expected){
  if(!expected?.length) return false;
  if(expected.includes(answer)) return true;
  const comp = compatibility[answer] || [];
  return expected.some(e => comp.includes(e));
}

function scoreCandidate(cand){
  let morphScore = 0, maxMorph = 0;
  let matchCount = 0, missCount = 0, unknownCount = 0;
  const rows = [];

  for(const ch of characters){
    const ans = answers[ch.id];
    if(!ans || ans === "unknown"){ unknownCount++; continue; }
    const expected = cand.traits ? cand.traits[ch.id] : null;
    if(!expected){
      rows.push({type:"eh", text:`${ch.title}: no profile data`});
      continue;
    }
    maxMorph += ch.weight;
    if(expected.includes(ans)){
      morphScore += ch.weight;
      matchCount++;
      rows.push({type:"ok", text:`${ch.title}: ${stateLabels[ans] || ans} ✓`});
    } else if(compatible(ans, expected)){
      morphScore += ch.weight * 0.45;
      matchCount++;
      rows.push({type:"eh",
        text:`${ch.title}: ${stateLabels[ans]||ans} compatible with ${expected.map(x=>stateLabels[x]||x).join(" / ")}`});
    } else {
      morphScore -= ch.weight * 0.70;
      missCount++;
      rows.push({type:"no",
        text:`${ch.title}: ${stateLabels[ans]||ans} — expected ${expected.map(x=>stateLabels[x]||x).join(" / ")}`});
    }
  }

  // Normalise morphology to 0–1, allowing for negative evidence
  const norm = maxMorph > 0
    ? Math.max(0, Math.min(1, (morphScore + maxMorph * 0.5) / (maxMorph * 1.5)))
    : 0.5;

  const prior    = Math.max(0.02, Math.min(1, cand.localPrior || 0.30));
  const quality  = cand.traitQuality === "reviewed" ? 1.0
                 : cand.traits       ? 0.75
                 :                     0.20;

  const score = Math.round(100 * (norm * 0.68 + prior * 0.22 + quality * 0.10));

  return {score, norm, prior, quality, matchCount, missCount, unknownCount, rows};
}

function getRankedCandidates(){
  const sortKey = els.sortBy?.value || "score";
  return candidates
    .map(c => ({...c, _score: scoreCandidate(c)}))
    .sort((a,b) => {
      if(sortKey === "morph")  return b._score.norm  - a._score.norm;
      if(sortKey === "prior")  return b._score.prior - a._score.prior;
      return b._score.score - a._score.score;
    });
}

/* ═══════════════════════════════════════════════════
   QUESTION SELECTION (information gain proxy)
═══════════════════════════════════════════════════ */
function chooseNextQuestion(){
  const unanswered = characters.filter(c => !answers[c.id]);
  if(!unanswered.length) return null;

  const top = getRankedCandidates().slice(0, Math.min(10, candidates.length));
  let best = unanswered[0], bestPower = -Infinity;

  for(const ch of unanswered){
    // Approximate discriminating power: how much do the top candidates diverge on this char?
    const stateSet = new Map();
    for(const c of top){
      const vals = c.traits?.[ch.id] || [];
      for(const v of vals) stateSet.set(v, (stateSet.get(v)||0)+1);
    }
    const unique = stateSet.size;
    const total  = [...stateSet.values()].reduce((a,b)=>a+b, 0);
    // Shannon-like diversity in the top candidates
    let diversity = 0;
    for(const cnt of stateSet.values()){
      const p = cnt / Math.max(1, total);
      diversity -= p * Math.log2(p + 1e-9);
    }
    const power = ch.weight * (unique * 0.4 + diversity * 0.6);
    if(power > bestPower){ bestPower = power; best = ch; }
  }
  return best.id;
}

