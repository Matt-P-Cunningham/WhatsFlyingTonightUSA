          ${c.localCount ? `<span class="tag">${c.localCount} local obs.</span>` : ""}
        </div>
        ${c.note ? `<div class="r-note">${esc(c.note)}</div>` : ""}
        <div class="evidence">
          ${evidence || '<div style="font-size:12px;color:var(--ink-soft)">Answer questions above to generate evidence.</div>'}
          ${sc.rows.length > 7 ? `<div style="font-size:11px;color:var(--ink-soft);margin-top:4px">… ${sc.rows.length-7} more characters scored</div>` : ""}
        </div>
        <div class="r-links">${links}</div>
      </div>
      <div class="r-foot">${esc(c.imageCredit || "No open-license image loaded.")}</div>
