<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moth Visual Identification Key</title>
<style>
/* ── Design tokens ─────────────────────────────────── */
:root {
  --ink:       #1a1a14;
  --ink-mid:   #4a4840;
  --ink-soft:  #7a7870;
  --paper:     #f6f4ee;
  --surface:   #ffffff;
  --surface2:  #f2f0e9;
  --border:    #dedad0;
  --border-hi: #c9c4b8;
  --accent:    #2e5e28;
  --accent-lt: #d8ecce;
  --accent-dk: #1d3e1a;
  --link:      #1a4b72;
  --warn-bg:   #fff8e6;
  --warn-brd:  #e8c966;
  --warn-ink:  #604a00;
  --bad:       #9b2d2d;
  --bad-bg:    #fdf0f0;
  --info-bg:   #e8f2f9;
  --info-brd:  #a9ccdf;
  --info-ink:  #103558;
  --r:         10px;
  --shadow:    0 4px 20px rgba(0,0,0,.07);
  --shadow-lg: 0 10px 40px rgba(0,0,0,.11);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--paper);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  font-size:14px;line-height:1.5}
a{color:var(--link);text-decoration:none}
a:hover{text-decoration:underline}

/* ── Header ─── */
header{
  background:var(--accent-dk);color:#fff;
  padding:14px 20px;
  position:sticky;top:0;z-index:30;
  border-bottom:3px solid var(--accent)
}
.hdr{max-width:1300px;margin:auto;display:flex;
  align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.hdr h1{font-size:17px;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:8px}
.hdr h1 svg{opacity:.8}
.hdr-right{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge{font-size:11px;padding:3px 8px;border-radius:999px;
  background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);color:#fff}
.badge.research{background:rgba(46,94,40,.5);border-color:rgba(100,180,90,.4)}

/* ── Layout ─── */
main{max-width:1300px;margin:auto;padding:16px}
.layout{display:grid;grid-template-columns:340px 1fr;gap:16px;align-items:start}
@media(max-width:1000px){.layout{grid-template-columns:1fr}}

/* ── Card ─── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:12px 16px;border-bottom:1px solid var(--border);background:var(--surface2);
  display:flex;justify-content:space-between;align-items:center;gap:8px}
.card-head h2{font-size:14px;font-weight:700}
.card-body{padding:16px}
.card-foot{padding:10px 16px;border-top:1px solid var(--border);background:var(--surface2);
  font-size:11px;color:var(--ink-soft)}

/* ── Form controls ─── */
input,select,button,textarea{font:inherit}
input,select{
  width:100%;border:1px solid var(--border);background:#fff;
  border-radius:7px;padding:9px 10px;color:var(--ink);
  transition:border-color .15s
}
input:focus,select:focus{outline:none;border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(46,94,40,.12)}
.input-row{display:flex;gap:8px}
.input-row input{flex:1}

button{
  border:1px solid var(--border);background:var(--surface);
  border-radius:7px;padding:9px 12px;cursor:pointer;color:var(--ink);
  white-space:nowrap;transition:background .12s,border-color .12s
}
button:hover:not(:disabled){background:var(--surface2);border-color:var(--border-hi)}
button:disabled{opacity:.4;cursor:not-allowed}
button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
button.primary:hover:not(:disabled){background:var(--accent-dk)}
button.ghost{background:transparent;border-color:transparent;color:var(--ink-mid)}
button.ghost:hover:not(:disabled){background:var(--surface2);border-color:var(--border)}
button.sm{padding:6px 9px;font-size:12px}

/* ── Notices ─── */
.notice{border-radius:8px;padding:10px 12px;font-size:12.5px;margin-top:10px}
.notice.info{background:var(--info-bg);border:1px solid var(--info-brd);color:var(--info-ink)}
.notice.warn{background:var(--warn-bg);border:1px solid var(--warn-brd);color:var(--warn-ink)}
.notice.err{background:var(--bad-bg);border:1px solid #e8a0a0;color:var(--bad)}
.notice strong{font-weight:700}

/* ── KPIs ─── */
.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.kpi{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px;text-align:center}
.kpi .n{font-size:22px;font-weight:800;line-height:1;color:var(--accent)}
.kpi .l{font-size:10px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.05em;margin-top:3px}

/* ── Tabs ─── */
.tab-bar{display:flex;gap:4px;border-bottom:1px solid var(--border);padding-bottom:0;margin-bottom:14px}
.tab{padding:8px 11px;font-size:13px;border:1px solid transparent;
  border-radius:7px 7px 0 0;border-bottom:none;background:none;cursor:pointer;
  color:var(--ink-mid);position:relative;bottom:-1px;transition:color .12s}
.tab:hover{color:var(--ink)}
.tab.active{background:var(--surface);border-color:var(--border);border-bottom-color:var(--surface);
  color:var(--ink);font-weight:600}

/* ── Key panel ─── */
.progress-track{height:5px;background:var(--surface2);border-radius:999px;overflow:hidden;margin-bottom:14px}
.progress-fill{height:100%;background:var(--accent);border-radius:999px;width:0%;transition:width .3s}

.q-diagram{position:relative;background:var(--surface2);border:1px solid var(--border);
  border-radius:8px;overflow:hidden;min-height:180px;max-height:240px;
  display:flex;align-items:center;justify-content:center}
.q-diagram img{width:100%;height:100%;object-fit:contain;display:block;max-height:240px}
.q-diagram-ph{padding:20px;text-align:center;color:var(--ink-soft);font-size:12px;line-height:1.5}
.q-diagram-credit{font-size:10.5px;color:var(--ink-soft);margin-top:6px;line-height:1.4}
.overlay{position:absolute;inset:0;pointer-events:none}
.hz{position:absolute;border:2px solid transparent;border-radius:8px;transition:.2s}
.hz.lit{border-color:rgba(46,94,40,.85);background:rgba(46,94,40,.1);
  box-shadow:inset 0 0 0 1px rgba(46,94,40,.3)}

.q-title{font-size:16px;font-weight:700;margin:12px 0 2px}
.q-help{font-size:12.5px;color:var(--ink-mid);margin-bottom:11px;line-height:1.4}

.option-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:7px}
.option{
  border:1px solid var(--border);border-radius:8px;background:#fff;
  padding:9px 11px;text-align:left;cursor:pointer;width:100%;
  transition:border-color .12s,background .12s
}
.option:hover{border-color:var(--accent);background:var(--accent-lt)}
.option.active{border-color:var(--accent);background:var(--accent-lt);font-weight:600}
.option .opt-label{font-size:13px;font-weight:600;color:var(--ink)}
.option .opt-desc{font-size:11px;color:var(--ink-soft);margin-top:2px;line-height:1.3}

.q-nav{display:flex;justify-content:space-between;gap:8px;margin-top:14px;flex-wrap:wrap}
.q-nav-left,.q-nav-right{display:flex;gap:6px}

/* ── Step indicator ─── */
.step-label{font-size:11px;color:var(--ink-soft);font-weight:600;text-transform:uppercase;
  letter-spacing:.06em}
.group-label{display:inline-block;font-size:10.5px;padding:2px 7px;border-radius:999px;
  background:var(--surface2);border:1px solid var(--border);color:var(--ink-soft);margin-bottom:6px}

/* ── Results ─── */
.results-section{margin-top:16px}
.results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
.r-card{border:1px solid var(--border);border-radius:var(--r);background:#fff;
  overflow:hidden;display:flex;flex-direction:column}
.r-card:hover{box-shadow:var(--shadow-lg);transform:translateY(-1px);transition:.15s}
.r-img{aspect-ratio:4/3;background:var(--surface2);position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center}
.r-img img{width:100%;height:100%;object-fit:cover;display:block}
.r-img-ph{font-size:11.5px;color:var(--ink-soft);text-align:center;padding:12px;line-height:1.4}
.score-badge{position:absolute;right:8px;top:8px;
  background:rgba(10,20,8,.75);color:#fff;border-radius:999px;
  padding:3px 8px;font-weight:800;font-size:12px;backdrop-filter:blur(4px)}
.score-badge.high{background:rgba(30,80,25,.85)}
.score-badge.mid{background:rgba(80,70,10,.85)}
.rank-badge{position:absolute;left:8px;top:8px;
  background:rgba(10,20,8,.6);color:rgba(255,255,255,.9);
  border-radius:4px;padding:2px 6px;font-size:10px;font-weight:700}

.r-body{padding:11px;flex:1}
.r-name{font-size:14px;font-weight:700}
.r-sci{font-style:italic;color:var(--ink-soft);font-size:11.5px;margin-top:1px}
.tag-row{display:flex;flex-wrap:wrap;gap:4px;margin:7px 0}
.tag{border:1px solid var(--border);border-radius:999px;
  padding:2px 7px;font-size:10.5px;color:var(--ink-mid);background:var(--surface2)}
.tag.green{background:var(--accent-lt);border-color:#9ecb92;color:var(--accent-dk)}
.tag.amber{background:var(--warn-bg);border-color:var(--warn-brd);color:var(--warn-ink)}
.tag.red{background:var(--bad-bg);border-color:#e0a0a0;color:var(--bad)}
.r-note{font-size:11.5px;color:var(--ink-mid);margin-bottom:6px;line-height:1.4}

.evidence{border-top:1px solid var(--border);padding-top:8px;margin-top:6px}
.ev-row{display:grid;grid-template-columns:14px 1fr;gap:5px;
  font-size:11.5px;color:var(--ink-mid);margin:3px 0;align-items:baseline}
.ev-icon{font-size:10px;text-align:center;font-weight:900}
.ev-icon.ok{color:var(--accent)}
.ev-icon.no{color:var(--bad)}
.ev-icon.eh{color:var(--ink-soft)}

.r-links{font-size:11px;margin-top:8px;color:var(--ink-soft);display:flex;flex-wrap:wrap;gap:4px}
.r-links a{color:var(--link)}

.r-foot{padding:7px 11px;border-top:1px solid var(--border);
  font-size:10.5px;color:var(--ink-soft);background:var(--surface2);line-height:1.3}

/* ── Filter bar ─── */
.filter-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.filter-bar label{font-size:12px;color:var(--ink-mid);white-space:nowrap}
.filter-bar select{width:auto;font-size:12px;padding:6px 8px}
.sort-row{display:flex;gap:6px;align-items:center}

/* ── Analytics table ─── */
table.atbl{width:100%;border-collapse:collapse;font-size:12px}
table.atbl th,table.atbl td{border-bottom:1px solid var(--border);
  padding:6px 8px;text-align:left;vertical-align:middle}
table.atbl th{color:var(--ink-soft);font-weight:700;background:var(--surface2);
  position:sticky;top:0}
table.atbl tbody tr:hover{background:var(--surface2)}
.bar-cell{display:flex;align-items:center;gap:5px}
.bar{height:6px;border-radius:999px;background:var(--accent);flex-shrink:0}

/* ── Diagram panel ─── */
.diag-wrap{position:relative;background:var(--surface2);border:1px solid var(--border);
  border-radius:8px;overflow:hidden;min-height:220px;max-height:600px;
  display:flex;align-items:center;justify-content:center}
.diag-wrap img{width:100%;height:auto;object-fit:contain;max-height:600px}
.diag-ph{padding:24px;text-align:center;color:var(--ink-soft);font-size:13px}
.diag-credit{font-size:11px;color:var(--ink-soft);margin-top:8px;line-height:1.4}
.diag-btns{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}

/* ── Sources ─── */
.source-list{display:grid;gap:8px}
.src{border:1px solid var(--border);border-radius:8px;padding:11px;background:#fff}
.src strong{display:block;font-size:13px;margin-bottom:3px}
.src p{font-size:12.5px;color:var(--ink-mid);line-height:1.4}

/* ── Status / misc ─── */
.status-line{font-size:12.5px;color:var(--ink-soft);margin-top:8px;min-height:16px}
.status-line.err{color:var(--bad)}
.status-line.ok{color:var(--accent)}
.hidden{display:none!important}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;
  background:var(--surface2);border:1px solid var(--border);border-radius:5px;padding:1px 5px}
.empty-state{text-align:center;padding:32px 20px;color:var(--ink-soft);font-size:13px;line-height:1.5}
.section-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;
  margin-bottom:10px}
.section-head h2{font-size:15px;font-weight:700}
footer{font-size:11.5px;color:var(--ink-soft);padding:18px 0 10px;
  max-width:1300px;margin:auto;line-height:1.5}

/* ── Confidence legend ─── */
.conf-legend{display:flex;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--ink-soft);
  margin-bottom:10px;align-items:center}
.conf-swatch{width:10px;height:10px;border-radius:2px;display:inline-block;vertical-align:middle;margin-right:3px}
</style>
</head>
<body>

<header>
  <div class="hdr">
    <h1>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
        <path d="M8 12s1.5-3 4-3 4 3 4 3-1.5 3-4 3-4-3-4-3z"/>
        <circle cx="12" cy="12" r="1.5"/>
      </svg>
      Moth Visual Identification Key
    </h1>
    <div class="hdr-right">
      <span class="badge research">Research prototype</span>
      <span class="badge">No AI-generated imagery</span>
    </div>
  </div>
</header>

<main>
  <div class="layout">

    <!-- Left: location + candidates -->
    <section class="card">
      <div class="card-head">
        <h2>Candidate pool</h2>
        <span class="step-label" id="candidate-count">Built-in profiles</span>
      </div>
      <div class="card-body">
        <div class="input-row">
          <input id="location-input" placeholder="City, region, or coordinates…" autocomplete="off">
          <button class="primary" id="search-btn">Search</button>
        </div>
        <div class="status-line" id="status">Location search adds iNaturalist occurrence priors. The key works immediately without a location.</div>
        <div class="kpi-row">
          <div class="kpi"><div class="n" id="kpi-candidates">0</div><div class="l">Candidates</div></div>
          <div class="kpi"><div class="n" id="kpi-profiled">0</div><div class="l">Trait-profiled</div></div>
          <div class="kpi"><div class="n" id="kpi-answers">0</div><div class="l">Answers given</div></div>
        </div>
        <div class="notice info" style="margin-top:12px">
          <strong>Scoring method.</strong> Score = 68% morphology + 22% local occurrence prior + 10% profile quality. Unanswered or skipped characters don't penalize any candidate.
        </div>
        <div class="notice warn">
          <strong>Important limits.</strong> Many moths cannot be identified to species from photos alone. For cryptic taxa, similar sister species, or worn specimens, genitalic dissection or DNA barcoding may be required.
        </div>
      </div>
    </section>

    <!-- Right: key + tabs -->
    <section class="card">
      <div class="card-head">
        <h2>Visual key</h2>
        <span class="step-label" id="step-label">Step 1</span>
      </div>
      <div class="card-body">
        <div class="tab-bar">
          <button class="tab active" data-panel="key-panel">Key</button>
          <button class="tab" data-panel="diagram-panel">Reference diagrams</button>
          <button class="tab" data-panel="analytics-panel">Analytics</button>
          <button class="tab" data-panel="sources-panel">Sources</button>
        </div>

        <!-- KEY PANEL -->
        <div id="key-panel">
          <div class="progress-track"><div class="progress-fill" id="progress-bar"></div></div>
          <div class="q-diagram" id="mini-diagram">
            <img id="question-diagram-img" alt="Wing diagram" style="display:none">
            <div class="q-diagram-ph" id="question-diagram-ph">Loading reference diagram…</div>
            <div class="overlay" id="question-overlay"></div>
          </div>
          <div class="q-diagram-credit" id="question-diagram-credit"></div>

          <div style="margin-top:14px">
            <div class="group-label" id="q-group">Group</div>
            <h3 class="q-title" id="question-title">Loading…</h3>
            <p class="q-help" id="question-help"></p>
            <div class="option-grid" id="options"></div>
          </div>

          <div class="q-nav">
            <div class="q-nav-left">
              <button id="back-btn" class="ghost sm">← Back</button>
              <button id="skip-btn" class="ghost sm">Skip / not visible</button>
            </div>
            <div class="q-nav-right">
              <button id="reset-btn" class="sm">Reset all</button>
              <button class="primary sm" id="next-btn">Next →</button>
            </div>
          </div>
        </div>

        <!-- DIAGRAM PANEL -->
        <div id="diagram-panel" class="hidden">
          <div class="notice info">Diagrams are fetched from Wikimedia Commons with license attribution. The overlay on the key panel highlights the region relevant to the current question.</div>
          <div class="diag-wrap" style="margin-top:12px" id="main-diag-wrap">
            <img id="main-diagram-img" alt="Lepidoptera diagram" style="display:none">
            <div class="diag-ph" id="main-diagram-ph">Click a button below to load a diagram.</div>
          </div>
          <div class="diag-credit" id="main-diagram-credit"></div>
          <div class="diag-btns">
            <button class="sm" id="load-wing-pattern">Wing pattern terminology</button>
            <button class="sm" id="load-venation">Venation diagram</button>
            <button class="sm" id="load-catocala">Underwing forewing pattern</button>
            <button class="sm" id="load-genitalia-note">⚠ Genitalia note</button>
          </div>
        </div>

        <!-- ANALYTICS PANEL -->
        <div id="analytics-panel" class="hidden">
          <div class="notice info">Live scoring breakdown for all candidates. Morphology score is normalised against the maximum possible for the characters answered so far.</div>
          <div style="overflow-x:auto;margin-top:12px">
            <table class="atbl" id="analytics-table"></table>
          </div>
        </div>

        <!-- SOURCES PANEL -->
        <div id="sources-panel" class="hidden">
          <div class="source-list">
            <div class="src"><strong>iNaturalist</strong>
              <p>Research-grade species counts and taxon photos from within 80 km of the entered location in the current seasonal window (±21 days). Photo license and attribution shown as returned by the API.</p>
            </div>
            <div class="src"><strong>Wikimedia Commons</strong>
              <p>Open-media reference photos and morphology diagrams via the MediaWiki imageinfo API. License metadata is fetched with each image.</p>
            </div>
            <div class="src"><strong>GBIF</strong>
              <p>Taxonomic backbone crosswalk via the GBIF Species Match API. Used for authoritative links, not trait scoring.</p>
            </div>
            <div class="src"><strong>BOLD Systems</strong>
              <p>Barcode of Life Data System. Visual trait scoring is not inferred from DNA data; links are provided for taxonomic context only.</p>
            </div>
            <div class="src"><strong>Curated trait matrix</strong>
              <p>This prototype includes <strong>18 species</strong> spanning Noctuidae, Erebidae, Geometridae, Sphingidae, and Saturniidae. Each profile carries a quality flag. The matrix should be expanded with cited regional monographs and reviewed by specialists before research use.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Results -->
  <section class="results-section">
    <div class="section-head">
      <h2>Ranked identification suggestions</h2>
      <div class="filter-bar">
        <label>Filter family:</label>
        <select id="filter-family"><option value="">All families</option></select>
        <label>Sort:</label>
        <select id="sort-by">
          <option value="score">Score</option>
          <option value="morph">Morphology</option>
          <option value="prior">Local prior</option>
        </select>
      </div>
    </div>
    <div class="conf-legend">
      <span><span class="conf-swatch" style="background:#2e5e28"></span> Score ≥70: strong match</span>
      <span><span class="conf-swatch" style="background:#8a7008"></span> Score 45–69: partial match</span>
      <span><span class="conf-swatch" style="background:#9b2d2d"></span> Score &lt;45: poor match</span>
    </div>
    <div id="results" class="results-grid">
      <div class="empty-state">Answer questions above to see ranked candidates.</div>
    </div>
  </section>
</main>

<footer>
  <strong>Privacy:</strong> Location data entered is sent only to Nominatim (OSM) for geocoding and to iNaturalist for occurrence priors. This file does not transmit your identification answers to any server.
  &nbsp;·&nbsp; <strong>Citation:</strong> If using this tool in research, note that it is a computational aid, not a taxonomic determination. Voucher specimens and expert review are always preferable.
</footer>

<script>
"use strict";

/* ═══════════════════════════════════════════════════
   CONSTANTS & API ENDPOINTS
═══════════════════════════════════════════════════ */
const API = {
  inatSpeciesCounts: "https://api.inaturalist.org/v1/observations/species_counts",
  nominatim: "https://nominatim.openstreetmap.org/search",
  commons: "https://commons.wikimedia.org/w/api.php",
  gbifMatch: "https://api.gbif.org/v1/species/match"
};

const MOTH_TAXON_ID   = 47157;
const BUTTERFLY_TAXON_ID = 47224;
const SEARCH_RADIUS_KM = 80;
const WINDOW_DAYS      = 21;

/* ═══════════════════════════════════════════════════
   STATE LABEL LOOKUP
═══════════════════════════════════════════════════ */
const stateLabels = {
  unknown:"Unknown / not visible",
  // antennae
  simple:"Threadlike / simple",
  pectinate:"Pectinate (comb on one side)",
  bipectinate:"Bipectinate (feathery both sides)",
