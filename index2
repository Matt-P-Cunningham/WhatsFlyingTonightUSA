function renderQuestion(){
  const q = charById(currentQid) || characters[0];
  const answeredCount = Object.values(answers).filter(v => v && v !== "unknown").length;
  const totalQ = characters.length;

  els.progressBar.style.width = `${Math.round((Object.keys(answers).length / totalQ) * 100)}%`;
  els.stepLabel.textContent   = `Step ${Math.min(Object.keys(answers).length + 1, totalQ)} of ${totalQ}`;
  els.qGroup.textContent      = q.group;
  els.qTitle.textContent      = q.title;
  els.qHelp.textContent       = q.help;
  els.kpiAnswers.textContent  = answeredCount;

  els.options.innerHTML = q.options.map(opt => `
    <button class="option ${answers[q.id] === opt ? "active" : ""}"
            data-value="${esc(opt)}" data-qid="${esc(q.id)}">
      <div class="opt-label">${esc(stateLabels[opt] || opt)}</div>
      <div class="opt-desc">${esc(getOptDesc(q.id, opt))}</div>
    </button>`).join("");

  els.options.querySelectorAll(".option").forEach(btn =>
    btn.addEventListener("click", () => setAnswer(btn.dataset.qid, btn.dataset.value))
  );

  updateDiagramOverlay(q.region);
}

function renderResults(){
  const ranked = getRankedCandidates();
  const familyFilter = els.filterFamily?.value || "";

  const filtered = familyFilter
    ? ranked.filter(c => (c.family||"") === familyFilter)
    : ranked;

  if(!filtered.length){
    els.results.innerHTML = '<div class="empty-state">No candidates match the current filter.</div>';
    return;
  }

  els.results.innerHTML = filtered.map((c,i) => resultCard(c, i)).join("");

  // Update family filter options
  const families = [...new Set(ranked.map(c => c.family).filter(Boolean))].sort();
  const current  = els.filterFamily.value;
  els.filterFamily.innerHTML =
    `<option value="">All families</option>` +
    families.map(f => `<option value="${esc(f)}" ${current===f?"selected":""}>${esc(f)}</option>`).join("");
  if(current) els.filterFamily.value = current;

  // KPIs
  els.kpiCandidates.textContent  = candidates.length;
  els.kpiProfiled.textContent    = candidates.filter(c => c.traits).length;
  els.candidateCount.textContent = localContext.loaded
    ? `${candidates.length} local + curated`
    : "Built-in profiles";
}

