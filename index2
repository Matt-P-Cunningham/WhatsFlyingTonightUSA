   NAVIGATION ACTIONS
═══════════════════════════════════════════════════ */
function setAnswer(qid, value){
  answers[qid] = value;
  renderAll();
}

function nextQuestion(){
  if(currentQid && !answers[currentQid]) answers[currentQid] = "unknown";
  const next = chooseNextQuestion();
  if(next){
    if(currentQid) questionHistory.push(currentQid);
    currentQid = next;
  }
  renderAll();
}

function backQuestion(){
  const prev = questionHistory.pop();
  if(prev){
    delete answers[currentQid]; // un-answer current before going back
    currentQid = prev;
  }
  renderAll();
}

function resetKey(){
  answers = {};
  questionHistory = [];
  currentQid = characters[0].id;
  candidates.forEach(c => { c.localPrior = c._basePrior || c.localPrior; });
  renderAll();
}

/* ═══════════════════════════════════════════════════
   iNATURALIST GEOCODE + OCCURRENCE
═══════════════════════════════════════════════════ */
async function geocode(q){
  const params = new URLSearchParams({q, format:"json", limit:"1"});
  const res = await fetch(`${API.nominatim}?${params}`,
    {headers:{"User-Agent":"moth-visual-key/4.0"}});
  if(!res.ok) throw new Error("Geocoding failed");
  const data = await res.json();
  if(!data.length) throw new Error("Location not found — try a nearby city or country name");
  return {
    lat: parseFloat(data[0].lat),
    lng: parseFloat(data[0].lon),
    name: data[0].display_name.split(",").slice(0,3).join(", ")
  };
}

async function loadLocalCandidates(){
  const q = els.locationInput.value.trim();
  if(!q){ setStatus("Enter a location first.", "err"); return; }
  els.searchBtn.disabled = true;
  setStatus("Geocoding location…");
  try{
    const loc = await geocode(q);
    localContext = {...loc, loaded:true};
    setStatus(`Fetching moth observations near ${loc.name}…`);

    const params = new URLSearchParams({
      taxon_id: String(MOTH_TAXON_ID),
      without_taxon_id: String(BUTTERFLY_TAXON_ID),
      lat: String(loc.lat),
      lng: String(loc.lng),
      radius: String(SEARCH_RADIUS_KM),
      month: getMonths(),
      quality_grade: "research",
      per_page: "100",
      order: "desc",
      order_by: "observations_count"
    });

    const res = await fetch(`${API.inatSpeciesCounts}?${params}`);
    if(!res.ok) throw new Error("iNaturalist request failed");
    const data = await res.json();
    const results = data.results || [];
    mergeINatCandidates(results);

    setStatus(`Loaded ${results.length} taxa near ${loc.name}. Enriching images…`, "ok");
    renderAll();
    scheduleImageEnrichment();
    enrichGbif();
  }catch(e){
    setStatus(e.message || "Could not load local candidates.", "err");
  }finally{
    els.searchBtn.disabled = false;
  }
}

function mergeINatCandidates(results){
  const maxCount = Math.max(1, ...results.map(r => r.count || 0));
  const bySci = new Map(candidates.map(c => [c.sci.toLowerCase(), c]));

  for(const r of results){
    const t = r.taxon || {};
    const sci = t.name; if(!sci) continue;
    const key = sci.toLowerCase();
    const prior = Math.max(0.05, Math.min(0.95,
      Math.log10((r.count||0)+1) / Math.log10(maxCount+1)));

    if(bySci.has(key)){
      const c = bySci.get(key);
      c.localCount   = r.count || 0;
      c.localPrior   = Math.max(c.localPrior || 0, prior);
      c.inat         = c.inat || t.id;
      c.common       = c.common || t.preferred_common_name;
      c.family       = c.family || t.iconic_taxon_name;
      if(!c.image) applyINatPhoto(c, t.default_photo);
    }else{
      const c = {
        sci,
        common:      t.preferred_common_name || sci,
        family:      t.iconic_taxon_name || "",
        inat:        t.id,
        source:      "inat",
        localCount:  r.count || 0,
        localPrior:  prior,
        traits:      null,
        traitQuality:null,
        image:       null,
        imageCredit: null,
        imageSource: null,
        gbifKey:     null,
        commonsPage: null,
        note:        "Occurrence candidate only — no curated trait profile."
      };
      applyINatPhoto(c, t.default_photo);
      candidates.push(c);
      bySci.set(key, c);
    }
  }
  // Trim to top 100 by prior to keep performance reasonable
  candidates = getRankedCandidates().map(({_score,...c})=>c).slice(0,100);
}

function applyINatPhoto(c, photo){
  if(!photo) return;
  const url = photo.medium_url || photo.square_url || photo.url;
  if(url){
    c.image       = url;
    c.imageCredit = `iNaturalist: ${photo.attribution||""} · ${photo.license_code||"license not returned"}`;
    c.imageSource = "iNaturalist";
  }
}

/* ═══════════════════════════════════════════════════
   IMAGE ENRICHMENT (Wikimedia Commons)
═══════════════════════════════════════════════════ */
async function fetchCommonsImage(search){
  try{
    const params = new URLSearchParams({
      action:"query", generator:"search",
      gsrsearch:`file:${search}`,
      gsrlimit:"6", gsrnamespace:"6",
      prop:"imageinfo", iiprop:"url|extmetadata",
      iiurlwidth:"800", format:"json", origin:"*"
    });
    const res = await fetch(`${API.commons}?${params}`);
    if(!res.ok) return null;
    const data = await res.json();
    const pages = Object.values(data.query?.pages || {});
    for(const p of pages){
      const info = p.imageinfo?.[0];
      if(!info?.thumburl && !info?.url) continue;
      const meta   = info.extmetadata || {};
      const license= stripHtml(meta.LicenseShortName?.value || meta.License?.value || "");
      const artist = stripHtml(meta.Artist?.value || meta.Credit?.value || "");
      return {
        url:    info.thumburl || info.url,
        page:   info.descriptionurl || meta.LicenseUrl?.value || "",
        credit: [artist, license].filter(Boolean).join("; ")
      };
    }
    return null;
  }catch(e){ return null; }
}

function stripHtml(html){ return String(html||"").replace(/<[^>]*>/g,"").replace(/\s+/g," ").trim(); }

function scheduleImageEnrichment(){
  imageEnrichQueue = getRankedCandidates()
    .slice(0, 18)
    .filter(c => !c.image)
    .map(c => c.sci);
  if(!enrichRunning) runEnrichQueue();
}

async function runEnrichQueue(){
  enrichRunning = true;
  while(imageEnrichQueue.length){
    const sci = imageEnrichQueue.shift();
    const c   = candidates.find(x => x.sci === sci);
    if(!c || c.image){ continue; }
    const img = await fetchCommonsImage(sci + " moth");
    if(img){
      c.image       = img.url;
      c.imageCredit = `Wikimedia Commons: ${img.credit}`;
      c.imageSource = "Wikimedia Commons";
      c.commonsPage = img.page;
      renderResults();
    }
    await sleep(120); // polite rate-limiting
  }
  enrichRunning = false;
}

function sleep(ms){ return new Promise(r=>setTimeout(r,ms)); }

/* ═══════════════════════════════════════════════════
   GBIF KEY ENRICHMENT
═══════════════════════════════════════════════════ */
async function enrichGbif(){
  const toEnrich = getRankedCandidates().slice(0,20).filter(c=>!c.gbifKey);
  for(const c of toEnrich){
    try{
      const params = new URLSearchParams({name:c.sci, kingdom:"Animalia",
        class:"Insecta", order:"Lepidoptera"});
      const res = await fetch(`${API.gbifMatch}?${params}`);
      if(res.ok){
        const d = await res.json();
        if(d.usageKey) c.gbifKey = d.usageKey;
      }
    }catch(e){}
    await sleep(80);
  }
  renderResults();
  renderAnalytics();
}

