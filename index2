  ).join("");

  const links = [
    c.inat    ? `<a href="https://www.inaturalist.org/taxa/${c.inat}" target="_blank" rel="noopener">iNat</a>` : "",
    c.gbifKey ? `<a href="https://www.gbif.org/species/${c.gbifKey}" target="_blank" rel="noopener">GBIF</a>`
              : `<a href="https://www.gbif.org/search?q=${encodeURIComponent(c.sci)}" target="_blank" rel="noopener">GBIF</a>`,
    `<a href="https://v3.boldsystems.org/index.php/Public_SearchTerms?query=${encodeURIComponent(c.sci)}" target="_blank" rel="noopener">BOLD</a>`,
    c.commonsPage ? `<a href="${esc(c.commonsPage)}" target="_blank" rel="noopener">Commons image</a>` : ""
  ].filter(Boolean).join(" · ");

  return `
    <article class="r-card">
      <div class="r-img">
        ${imgEl}
        <div class="score-badge ${scoreCls}">${sc.score}</div>
        <div class="rank-badge">#${rank+1}</div>
      </div>
      <div class="r-body">
        <div class="r-name">${esc(c.common || c.sci)}</div>
        <div class="r-sci">${esc(c.sci)}${c.family ? " · " + esc(c.family) : ""}</div>
        <div class="tag-row">
          <span class="tag">morph ${(sc.norm*100).toFixed(0)}%</span>
          <span class="tag">prior ${(sc.prior*100).toFixed(0)}%</span>
