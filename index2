  const scoreCls = sc.score >= 70 ? "high" : sc.score >= 45 ? "mid" : "";
  const qualTag  = c.traitQuality === "reviewed"
    ? `<span class="tag green">trait-reviewed</span>`
    : c.traits
      ? `<span class="tag amber">starter profile</span>`
      : `<span class="tag">occurrence only</span>`;

  const evidence = sc.rows.slice(0,7).map(r =>
    `<div class="ev-row">
       <span class="ev-icon ${r.type==="ok"?"ok":r.type==="no"?"no":"eh"}">
         ${r.type==="ok"?"✓":r.type==="no"?"✗":"—"}
       </span>
       <span>${esc(r.text)}</span>
